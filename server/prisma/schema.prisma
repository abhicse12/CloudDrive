// CloudDrive database schema.
//
// Conventions:
// - Models/fields are camelCase in JavaScript, but mapped (@map/@@map) to snake_case
//   tables and columns in PostgreSQL, which is the SQL convention and easier to query by hand.
// - Primary keys are UUIDs generated by PostgreSQL itself (gen_random_uuid()), so rows
//   inserted by raw SQL or other tools get IDs too.
// - All timestamps are timestamptz (stored in UTC) with millisecond precision.
// - File sizes are BigInt: 5 GiB doesn't fit in a 32-bit integer.
//
// Some rules can't be written in Prisma's language (CHECK constraints, partial/expression
// unique indexes). Those live as raw SQL inside the migration files - see migrations/.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// Upload lifecycle. A row is created as UPLOADING before bytes are stored, so a crash
/// mid-upload leaves a detectable row that the cleanup job can repair.
enum FileStatus {
  UPLOADING
  ACTIVE
  FAILED
}

enum FileCategory {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum ActivityAction {
  FILE_UPLOADED
  FILE_RENAMED
  FILE_MOVED
  FILE_TRASHED
  FILE_RESTORED
  FILE_DELETED
  FOLDER_CREATED
  FOLDER_RENAMED
  FOLDER_MOVED
  FOLDER_TRASHED
  FOLDER_RESTORED
  FOLDER_DELETED
  SHARE_CREATED
  SHARE_REVOKED
  PASSWORD_CHANGED
}

enum ActivityTarget {
  FILE
  FOLDER
  SHARE
  ACCOUNT
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @db.VarChar(100)
  /// Always stored lower-cased (enforced by a CHECK constraint).
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  /// Bytes used, INCLUDING space reserved by uploads in progress and files in trash.
  storageUsed  BigInt     @default(0) @map("storage_used")
  /// Bytes allowed. Default 5 GiB = 5 * 1024^3.
  storageLimit BigInt     @default(5368709120) @map("storage_limit")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  folders             Folder[]
  files               File[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  activityLogs        ActivityLog[]

  @@map("users")
}

model Folder {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// null = folder sits at the user's root.
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @db.VarChar(255)
  /// Set when the folder is in trash. Its whole subtree gets the SAME timestamp,
  /// which is how "restore folder" knows which items were trashed together.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Self-relation: a folder has one parent and many children.
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  files    File[]

  // "List this folder's subfolders" - the most frequent folder query.
  @@index([userId, parentId])
  // Unique folder name per parent (case-insensitive, ignoring trashed folders) is a
  // partial expression index, created with raw SQL in the migration.
  @@map("folders")
}

model File {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  /// null = file sits at the user's root.
  folderId     String?      @map("folder_id") @db.Uuid
  /// Display name only. NEVER used to build a storage path.
  originalName String       @map("original_name") @db.VarChar(255)
  /// Generated key in the storage provider, e.g. "users/<userId>/<uuid>".
  storageKey   String       @unique @map("storage_key") @db.VarChar(512)
  /// Detected from the file's bytes, not trusted from the browser.
  mimeType     String       @map("mime_type") @db.VarChar(255)
  category     FileCategory
  sizeBytes    BigInt       @map("size_bytes")
  status       FileStatus   @default(UPLOADING)
  /// Set when the file is in trash.
  deletedAt    DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// NoAction (not Cascade): the database refuses to delete a folder row that still has
  /// file rows. Files must be deleted through the service first, which also removes
  /// their stored bytes - so a folder delete can never leave orphaned objects in storage.
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: NoAction)
  shares Share[]

  // Folder listing (hottest query): WHERE user_id = ? AND folder_id = ? AND deleted_at IS NULL
  @@index([userId, folderId, deletedAt])
  // Recent files and trash, newest first.
  @@index([userId, deletedAt, createdAt(sort: Desc)])
  // Category filter and "storage by category" stats.
  @@index([userId, category])
  // Cleanup job: find uploads stuck in UPLOADING.
  @@index([status, createdAt])
  // Fast "name contains ..." search using trigrams (needs the pg_trgm extension).
  @@index([originalName(ops: raw("gin_trgm_ops"))], type: Gin, map: "files_original_name_trgm_idx")
  @@map("files")
}

model Share {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileId         String    @map("file_id") @db.Uuid
  /// SHA-256 (hex) of the share token. The token itself is never stored.
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  /// null = never expires.
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  accessCount    Int       @default(0) @map("access_count")
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("shares")
}

/// One row per logged-in device. Holds the hash of the refresh token, so a session can
/// be revoked (logout, password change, suspension) even though JWTs are stateless.
model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ip               String?   @db.VarChar(45)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set once used: reset tokens are single-use.
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ActivityLog {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  action     ActivityAction
  targetType ActivityTarget @map("target_type")
  /// Not a foreign key on purpose: the log must survive after its target is deleted.
  targetId   String?        @map("target_id") @db.Uuid
  /// Snapshot of useful details at the time, e.g. { "name": "Report.pdf" }.
  metadata   Json?          @db.JsonB
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "Recent activity" for a user, newest first.
  @@index([userId, createdAt(sort: Desc)])
  @@map("activity_logs")
}
