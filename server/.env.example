# Copy this file to .env and adjust values. NEVER commit .env.
# Placeholder values only.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Docker dev database from docker-compose.yml (host port 5434)
DATABASE_URL=postgresql://clouddrive:change_me@localhost:5434/clouddrive

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally, 1 behind an AWS ALB)
TRUST_PROXY=0

# ─── Auth ───
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Must be true in production (HTTPS)
COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30

# ─── Frontend / email ───
# Public URL of the web app (used in email links)
APP_URL=http://localhost:5173
# "console" prints emails to the server log (AWS SES comes in Phase 8).
# Refused when NODE_ENV=production: reset links would end up in the logs.
EMAIL_PROVIDER=console

# ─── First admin user (used only by: npm run db:seed -w server) ───
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=choose_a_strong_password

# ─── Storage ───
# Default per-user quota in bytes (5 GiB)
DEFAULT_STORAGE_LIMIT_BYTES=5368709120

# ─── File storage ───
# "local" = this machine's disk (S3 comes in Phase 8). Relative paths are from server/.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage-data
UPLOAD_TMP_DIR=./tmp-uploads
# Signs download links; must differ from JWT_ACCESS_SECRET. Generate like the JWT secret.
STORAGE_SIGNING_SECRET=replace_with_another_long_random_secret_32_chars_min
SIGNED_URL_TTL_SECONDS=300

# ─── Uploads ───
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_UPLOAD=20

# ─── Background jobs ───
TRASH_RETENTION_DAYS=30
JOBS_ENABLED=true
